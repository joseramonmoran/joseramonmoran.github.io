source 'https://rubygems.org'

# GitHub Pages builds this site with its own pinned gem set. Declaring the
# github-pages gem alone keeps local previews on exactly the same versions.
# Do not add a bare `gem "jekyll"` or version pins here -- that is what makes
# the GitHub Pages build fail with "can't satisfy your Gemfile's dependencies".
gem 'github-pages', group: :jekyll_plugins
gem 'webrick', '~> 1.8'
